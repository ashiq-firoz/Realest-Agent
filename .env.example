# PostgreSQL
POSTGRES_DB=realestate
POSTGRES_USER=realestate_user
POSTGRES_PASSWORD=<strong-password>

# Redis
REDIS_URL=redis://redis:6379/0

# Gemini AI — REQUIRED. Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<random-secret-min-32-chars>
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Australian property data (all free) ───────────────────────────────────────
# PropertyLens — OPTIONAL. Free tier returns real comparable listings (no prices) but
# is heavily limited: ~5 requests/DAY (and 2/min) — effectively demo-only. When unset
# or the limit is hit, the report's Comparable Properties section shows an empty state
# (no fake data). Obtain from https://app.propertylens.au/
PROPERTYLENS_API_KEY=<your-propertylens-api-key>

# ABS Data API (demographics + price index) and OpenStreetMap Overpass (amenities)
# need NO API key. Override the base URLs only if necessary.
ABS_API_BASE=https://data.api.abs.gov.au
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Domain API — DROPPED. Its listings _search requires a paid OAuth plan; left
# optional purely for backward compatibility. Leave blank.
DOMAIN_API_KEY=

# Google OAuth (optional) — obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Cache TTL in seconds (default: 6 hours) — also shields the PropertyLens rate limit
CACHE_TTL_SECONDS=21600

# Backend URL used by the frontend SERVER (RSC/SSR/NextAuth) — internal docker host.
BACKEND_URL=http://backend:8000

# Backend URL the BROWSER calls. NOTE: this is inlined into the client bundle at
# BUILD time (passed as a docker build arg), so after changing it you must rebuild
# the frontend image (`docker compose up --build`). Set it to the publicly reachable
# backend URL — for local docker that's the published port below.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
